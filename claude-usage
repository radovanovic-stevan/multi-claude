#!/usr/bin/env python3
# claude-usage - show subscription usage for each Claude Code account.
#
# Reads each account's OAuth token straight from the macOS Keychain (the same
# per-account slots that `claude-acct` manages) and queries Anthropic's usage
# endpoint - the data behind Claude Code's own `/usage` view.
#
# Fetches fresh on every run (no background polling). If an account has no
# stored login, an expired session, or the API can't be reached, that account
# shows a warning instead of numbers.
#
#   claude-usage                 colored bars for every account
#   claude-usage --json          machine-readable (used by the desktop widget)
#   claude-usage --watch [SECS]  full-screen view that refetches every SECS (300)
#   claude-usage --line [LABEL]  one compact line for a Claude Code status line;
#                                defaults to the account of $CLAUDE_CONFIG_DIR and
#                                caches results for CLAUDE_USAGE_TTL secs (300)

import hashlib
import json
import os
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.request
from datetime import datetime, timezone

# ---- accounts --------------------------------------------------------------
# Claude Code keys its Keychain login per config dir, in a slot named
# "Claude Code-credentials-<sha256(config_dir)[:8]>" (and maintains/refreshes it
# itself). We read that slot directly so the data is always current; claude-acct
# also mirrors the login into a stable "-<label>" slot as a fallback.
#
# Accounts come from the same external config file claude-acct uses, so the two
# tools never drift. Each line is:  <label>  <config_dir>  [email]
# The mirror slot is derived as "Claude Code-credentials-<label>".
CONFIG_FILE = os.environ.get("CLAUDE_ACCT_CONFIG") or os.path.join(
    os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"),
    "claude-acct", "accounts",
)
KEYCHAIN_ACCT = os.environ.get("USER", "")


def load_accounts():
    """Read accounts from CONFIG_FILE -> list of (label, config_dir, mirror_slot, email)."""
    accounts = []
    try:
        with open(CONFIG_FILE) as fh:
            lines = fh.readlines()
    except OSError:
        return accounts
    for raw in lines:
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        parts = line.split()
        label, config_dir = parts[0], parts[1] if len(parts) > 1 else ""
        if not config_dir:
            continue
        email = parts[2] if len(parts) > 2 else ""
        accounts.append((label, config_dir, f"Claude Code-credentials-{label}", email))
    return accounts


ACCOUNTS = load_accounts()


def slot_for_dir(config_dir):
    h = hashlib.sha256(os.path.expanduser(config_dir).encode()).hexdigest()[:8]
    return f"Claude Code-credentials-{h}"

USAGE_URL = "https://api.anthropic.com/api/oauth/usage"
HEADERS = {
    "anthropic-beta": "oauth-2025-04-20",
    "anthropic-version": "2023-06-01",
    "User-Agent": "claude-usage-widget/0.1",
}

BAR_WIDTH = 18

# ---- colors ----------------------------------------------------------------
USE_COLOR = sys.stdout.isatty() and "NO_COLOR" not in os.environ


def c(code, s):
    return f"\033[{code}m{s}\033[0m" if USE_COLOR else s


DIM = lambda s: c("2", s)
BOLD = lambda s: c("1", s)
RED = lambda s: c("31", s)
YELLOW = lambda s: c("33", s)
GREEN = lambda s: c("32", s)
CYAN = lambda s: c("36", s)


def sev_color(severity, pct):
    if severity == "critical" or pct >= 90:
        return RED
    if severity == "warning" or pct >= 70:
        return YELLOW
    return GREEN


# ---- keychain --------------------------------------------------------------
def read_slot(service):
    try:
        out = subprocess.run(
            ["security", "find-generic-password", "-s", service,
             "-a", KEYCHAIN_ACCT, "-w"],
            capture_output=True, text=True,
        )
    except FileNotFoundError:
        return None
    if out.returncode != 0:
        return None
    try:
        return json.loads(out.stdout)["claudeAiOauth"]
    except (json.JSONDecodeError, KeyError, TypeError):
        return None


def get_oauth(config_dir, mirror_slot):
    """Read the per-config-dir slot Claude Code maintains itself (always fresh);
    fall back to the stable mirror slot written by claude-acct."""
    return read_slot(slot_for_dir(config_dir)) or read_slot(mirror_slot)


# ---- usage fetch -----------------------------------------------------------
class Unreachable(Exception):
    pass


def fetch_usage(token, timeout=15):
    req = urllib.request.Request(USAGE_URL, headers={**HEADERS, "Authorization": f"Bearer {token}"})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            return json.loads(resp.read().decode())
    except urllib.error.HTTPError as e:
        if e.code in (401, 403):
            raise Unreachable("session expired")
        raise Unreachable(f"HTTP {e.code}")
    except (urllib.error.URLError, TimeoutError, OSError):
        raise Unreachable("no network")
    except json.JSONDecodeError:
        raise Unreachable("bad response")


# ---- normalize -------------------------------------------------------------
LIMIT_LABELS = {
    "session": "Session (5h)",
    "weekly_all": "Weekly (all)",
    "weekly_opus": "Weekly (Opus)",
    "weekly_sonnet": "Weekly (Sonnet)",
}


def money(block):
    if not block:
        return None
    exp = block.get("exponent", 2)
    return (block.get("amount_minor", 0) or 0) / (10 ** exp), block.get("currency", "")


def normalize(data):
    """Flatten the usage payload into a stable shape for text + JSON output."""
    limits = data.get("limits") or []
    if not limits:  # fall back to flat fields if `limits` ever disappears
        for kind, blk in (("session", data.get("five_hour")), ("weekly_all", data.get("seven_day"))):
            if blk:
                limits.append({"kind": kind, "percent": blk.get("utilization", 0),
                               "resets_at": blk.get("resets_at"), "severity": "normal"})
    out_limits = []
    for lim in limits:
        kind = lim.get("kind", "?")
        out_limits.append({
            "kind": kind,
            "label": LIMIT_LABELS.get(kind, kind.replace("_", " ").title()),
            "percent": float(lim.get("percent", 0) or 0),
            "severity": lim.get("severity") or "normal",
            "resets_at": lim.get("resets_at"),
        })

    spend = data.get("spend") or {}
    out_spend = None
    if spend.get("enabled"):
        used, limit = money(spend.get("used")), money(spend.get("limit"))
        if used and limit:
            out_spend = {
                "percent": float(spend.get("percent", 0) or 0),
                "severity": spend.get("severity") or "normal",
                "used": used[0], "limit": limit[0], "currency": limit[1],
            }
    return out_limits, out_spend


def gather_one(label, config_dir, mirror_slot, email, timeout=15):
    acct = {"label": label, "email": email}
    oauth = get_oauth(config_dir, mirror_slot)
    token = oauth.get("accessToken") if oauth else None
    if not token:
        acct.update(ok=False, error="not logged in", hint=f"run: claude-acct {label}")
    else:
        try:
            limits, spend = normalize(fetch_usage(token, timeout))
            acct.update(ok=True, limits=limits, spend=spend)
        except Unreachable as e:
            expired = "expired" in str(e)
            acct.update(ok=False, error=str(e),
                        hint=f"re-login: claude-acct {label}" if expired else "try again later")
    return acct


def gather():
    """Build the full report (all accounts) used by both renderers."""
    return {"generated_at": datetime.now().astimezone().isoformat(timespec="seconds"),
            "accounts": [gather_one(*a) for a in ACCOUNTS]}


# ---- text rendering --------------------------------------------------------
def bar(pct, color):
    pct = max(0.0, min(100.0, float(pct)))
    filled = int(round(pct / 100 * BAR_WIDTH))
    return color("█" * filled) + DIM("░" * (BAR_WIDTH - filled))


def fmt_reset(iso):
    if not iso:
        return ""
    try:
        dt = datetime.fromisoformat(iso).astimezone()
    except ValueError:
        return ""
    now = datetime.now(timezone.utc).astimezone()
    delta = dt - now
    secs = int(delta.total_seconds())
    if secs <= 0:
        when = "due"
    elif secs < 86400:
        h, m = divmod(secs // 60, 60)
        when = f"in {h}h {m:02d}m" if h else f"in {m}m"
    else:
        when = dt.strftime("in %a %d %b")
    return DIM(f"resets {when} ({dt.strftime('%H:%M')})")


def render_text(report):
    now = datetime.fromisoformat(report["generated_at"]).strftime("%a %d %b %H:%M")
    print()
    print(CYAN("  ⚡ Claude usage") + DIM(f"   ·   {now}"))
    print(DIM("  " + "─" * 46))
    if not report["accounts"]:
        print(f"  {YELLOW('⚠ no accounts configured')}")
        print(DIM(f"    add some to {CONFIG_FILE}"))
        print()
        return
    for acct in report["accounts"]:
        print(f"  {BOLD(acct['label'].capitalize())}  {DIM(acct['email'])}")
        if not acct.get("ok"):
            print(f"    {YELLOW('⚠ ' + acct['error'])}  {DIM(acct.get('hint', ''))}")
            print()
            continue
        for lim in acct["limits"]:
            color = sev_color(lim["severity"], lim["percent"])
            pct = color("%3.0f%%" % lim["percent"])
            print(f"    {lim['label']:<14}{bar(lim['percent'], color)} "
                  f"{pct}  {fmt_reset(lim['resets_at'])}")
        spend = acct.get("spend")
        if spend:
            color = sev_color(spend["severity"], spend["percent"])
            pct = color("%3.0f%%" % spend["percent"])
            money_txt = DIM("%.2f / %.2f %s" % (spend["used"], spend["limit"], spend["currency"]))
            print(f"    {'Extra usage':<14}{bar(spend['percent'], color)} {pct}  {money_txt}")
        print()


# ---- status line -----------------------------------------------------------
# Claude Code re-runs its status line command after every message, so --line
# serves from a small per-account cache and only hits the API once per TTL.
# The cache holds usage numbers only - never the token.
CACHE_DIR = os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"),
                         "claude-usage")
CACHE_TTL = int(os.environ.get("CLAUDE_USAGE_TTL", "300"))
SHORT_LABELS = {"session": "5h", "weekly_all": "wk", "weekly_opus": "opus",
                "weekly_sonnet": "sonnet"}


def current_account(label=None):
    """The account named `label`, else the one whose config dir is
    $CLAUDE_CONFIG_DIR (or ~/.claude when unset, like Claude Code itself)."""
    if label:
        return next((a for a in ACCOUNTS if a[0] == label), None)
    cur = os.path.realpath(os.path.expanduser(
        os.environ.get("CLAUDE_CONFIG_DIR") or "~/.claude"))
    return next((a for a in ACCOUNTS
                 if os.path.realpath(os.path.expanduser(a[1])) == cur), None)


def cached_account(account):
    """Return (acct, stale) for one account, refetching once the cache is older
    than CACHE_TTL. On a failed refetch the last good numbers are kept (stale)."""
    path = os.path.join(CACHE_DIR, f"{account[0]}.json")
    try:
        with open(path) as fh:
            cache = json.load(fh)
    except (OSError, json.JSONDecodeError):
        cache = {}
    if time.time() - cache.get("checked_at", 0) < CACHE_TTL and cache.get("acct"):
        return cache["acct"], cache.get("stale", False)

    fresh = gather_one(*account, timeout=5)
    good = cache.get("acct") if cache.get("acct", {}).get("ok") else None
    acct, stale = (fresh, False) if fresh.get("ok") or not good else (good, True)
    try:
        os.makedirs(CACHE_DIR, exist_ok=True)
        # Retry no sooner than the TTL even on failure, so a dead network or an
        # expired login doesn't stall every status line refresh.
        fd, tmp = tempfile.mkstemp(dir=CACHE_DIR)
        with os.fdopen(fd, "w") as fh:
            json.dump({"checked_at": time.time(), "acct": acct, "stale": stale}, fh)
        os.replace(tmp, path)
    except OSError:
        pass
    return acct, stale


def short_reset(iso):
    try:
        secs = int((datetime.fromisoformat(iso) - datetime.now(timezone.utc)).total_seconds())
    except (TypeError, ValueError):
        return ""
    if secs <= 0:
        return ""
    if secs < 86400:
        h, m = divmod(secs // 60, 60)
        return f"{h}h{m:02d}m" if h else f"{m}m"
    return f"{secs // 86400}d"


def render_line(label=None):
    account = current_account(label)
    if not account:
        print(DIM("usage: unknown account"))
        return
    acct, stale = cached_account(account)
    parts = [BOLD(acct["label"])]
    if not acct.get("ok"):
        parts.append(YELLOW("⚠ " + acct["error"]))
    else:
        for lim in acct["limits"]:
            color = sev_color(lim["severity"], lim["percent"])
            reset = short_reset(lim["resets_at"])
            parts.append(f"{SHORT_LABELS.get(lim['kind'], lim['kind'])} "
                         + color("%.0f%%" % lim["percent"])
                         + (DIM(f" ↻{reset}") if reset else ""))
        spend = acct.get("spend")
        if spend and spend["used"] > 0:
            color = sev_color(spend["severity"], spend["percent"])
            parts.append("extra " + color("%.2f %s" % (spend["used"], spend["currency"])))
        if stale:
            parts.append(YELLOW("⚠ stale"))
    print(DIM(" · ").join(parts))


# ---- watch -------------------------------------------------------------
def watch(interval):
    """Full-screen view: refetch every `interval` secs, redraw the reset
    countdowns every 30s in between. Ctrl-C to quit."""
    sys.stdout.write("\033[?25l")                       # hide cursor
    try:
        report, fetched = None, 0.0
        while True:
            if time.time() - fetched >= interval:
                report, fetched = gather(), time.time()
            sys.stdout.write("\033[H\033[2J")               # home + clear
            render_text(report)
            print(DIM(f"  refreshes every {interval // 60 or 1}m · ctrl-c to quit"))
            sys.stdout.flush()
            time.sleep(min(30, interval))
    finally:
        sys.stdout.write("\033[?25h")
        sys.stdout.flush()


# ---- main ------------------------------------------------------------------
def arg_after(flag, default=None):
    args = sys.argv[1:]
    i = args.index(flag)
    nxt = args[i + 1] if i + 1 < len(args) else None
    return nxt if nxt and not nxt.startswith("-") else default


def main():
    global USE_COLOR
    args = sys.argv[1:]
    if "--line" in args:
        # Claude Code pipes the status line, but it does render ANSI colors.
        USE_COLOR = "NO_COLOR" not in os.environ
        render_line(arg_after("--line"))
    elif "--watch" in args:
        watch(max(60, int(arg_after("--watch", "300"))))
    elif "--json" in args:
        print(json.dumps(gather()))
    else:
        render_text(gather())


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        sys.exit(130)
